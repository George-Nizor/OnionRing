[
  { "id": "rpcs3", "name": "RPCS3", "platforms": ["ps3"], "exe": "^rpcs3\\.exe$",
    "args": ["--no-gui", "{rom}"], "repo": "RPCS3/rpcs3-binaries-win", "asset": "_win64_msvc\\.7z$",
    "homepage": "https://rpcs3.net", "requires": "Your own PS3 firmware (PS3UPDAT.PUP from Sony)",
    "persist": ["dev_hdd0", "dev_flash", "dev_flash2", "dev_flash3", "config", "savestates", "GuiConfigs", "patches"],
    "carry": ["games.yml", "config.yml"] },
  { "id": "pcsx2", "name": "PCSX2", "platforms": ["ps2"], "exe": "^pcsx2(-qt)?(x64)?(-avx2)?\\.exe$",
    "args": ["-batch", "-fullscreen", "--", "{rom}"], "repo": "PCSX2/pcsx2", "asset": "windows-x64-Qt\\.7z$",
    "homepage": "https://pcsx2.net", "portable": "portable.ini", "requires": "Your own PS2 BIOS dump",
    "persist": ["bios", "memcards", "inis", "sstates", "covers", "cheats", "gamesettings", "inputprofiles", "snaps"] },
  { "id": "duckstation", "name": "DuckStation", "platforms": ["ps1"], "exe": "^duckstation-qt.*\\.exe$",
    "args": ["-batch", "-fullscreen", "--", "{rom}"], "repo": "stenzek/duckstation", "asset": "duckstation-windows-x64-release\\.zip$",
    "homepage": "https://www.duckstation.org", "portable": "portable.txt", "requires": "Your own PS1 BIOS dump",
    "persist": ["bios", "memcards", "savestates", "gamesettings", "covers", "inputprofiles"], "carry": ["settings.ini"] },
  { "id": "ppsspp", "name": "PPSSPP", "platforms": ["psp"], "exe": "^PPSSPPWindows64\\.exe$",
    "args": ["{rom}", "--fullscreen"], "repo": "hrydgard/ppsspp", "asset": "Windows-x64\\.zip$",
    "homepage": "https://www.ppsspp.org" },
  { "id": "shadps4", "name": "shadPS4", "platforms": ["ps4"], "exe": "^shadps4\\.exe$",
    "args": ["-g", "{rom}"], "repo": "shadps4-emu/shadPS4", "asset": "win64-sdl.*\\.zip$",
    "homepage": "https://shadps4.net", "requires": "Your own decrypted PS4 game dumps" },
  { "id": "sharpemu", "name": "SharpEmu", "platforms": ["ps5"], "exe": "^sharpemu\\.exe$",
    "args": ["{rom}"], "repo": "sharpemu/sharpemu", "asset": "win-x64\\.zip$",
    "requires": "Your own decrypted PS5 game dumps",
    "notes": "Experimental. About ten tested games are playable." },
  { "id": "kytyps5", "name": "KytyPS5", "platforms": ["ps5"], "exe": "^kyty.*\\.exe$",
    "args": ["{rom}"], "repo": "KytyPS5/KytyPS5", "asset": "Windows-x64\\.zip$",
    "requires": "Your own decrypted PS5 game dumps",
    "notes": "Experimental. Starts from its own launcher; launching games directly may not work yet." },
  { "id": "dolphin", "name": "Dolphin", "platforms": ["gc", "wii"], "exe": "^dolphin\\.exe$",
    "args": ["-b", "-e", "{rom}"], "homepage": "https://dolphin-emu.org/download/", "portable": "portable.txt" },
  { "id": "cemu", "name": "Cemu", "platforms": ["wiiu"], "exe": "^cemu\\.exe$",
    "args": ["-f", "-g", "{rom}"], "repo": "cemu-project/Cemu", "asset": "windows-x64\\.zip$",
    "homepage": "https://cemu.info", "requires": "Your own Wii U keys and game dumps" },
  { "id": "azahar", "name": "Azahar", "platforms": ["3ds"], "exe": "^azahar(-qt)?\\.exe$",
    "args": ["{rom}"], "repo": "azahar-emu/azahar", "asset": "^azahar-windows-msvc-[^-]+\\.zip$",
    "homepage": "https://azahar-emu.org" },
  { "id": "citra", "name": "Citra", "platforms": ["3ds"], "exe": "^citra-qt\\.exe$",
    "args": ["{rom}"], "homepage": "https://github.com/azahar-emu/azahar",
    "notes": "Citra was discontinued in 2024. Azahar is its maintained successor and reads the same games." },
  { "id": "melonds", "name": "melonDS", "platforms": ["nds"], "exe": "^melonds\\.exe$",
    "args": ["-f", "{rom}"], "repo": "melonDS-emu/melonDS", "asset": "windows-x86_64\\.zip$",
    "homepage": "https://melonds.kuribo64.net" },
  { "id": "desmume", "name": "DeSmuME", "platforms": ["nds"], "exe": "^desmume.*\\.exe$",
    "args": ["{rom}"], "homepage": "https://desmume.org",
    "notes": "DeSmuME is largely unmaintained. melonDS is more accurate and actively developed." },
  { "id": "mgba", "name": "mGBA", "platforms": ["gba", "gbc", "gb"], "exe": "^mgba\\.exe$",
    "args": ["-f", "{rom}"], "repo": "mgba-emu/mgba", "asset": "win64\\.7z$", "homepage": "https://mgba.io" },
  { "id": "rmg", "name": "Rosalie's Mupen GUI", "platforms": ["n64"], "exe": "^rmg\\.exe$",
    "args": ["--fullscreen", "{rom}"], "repo": "Rosalie241/RMG", "asset": "Portable-Windows64.*\\.zip$" },
  { "id": "mesen", "name": "Mesen", "platforms": ["nes", "snes", "gb", "gbc"], "exe": "^mesen\\.exe$",
    "args": ["--fullscreen", "{rom}"], "repo": "SourMesen/Mesen2", "asset": "_Windows\\.zip$" },
  { "id": "flycast", "name": "Flycast", "platforms": ["dreamcast"], "exe": "^flycast\\.exe$",
    "args": ["{rom}"], "repo": "flyinghead/flycast", "asset": "win64.*\\.zip$" },
  { "id": "xemu", "name": "xemu", "platforms": ["xbox"], "exe": "^xemu\\.exe$",
    "args": ["-full-screen", "-dvd_path", "{rom}"], "repo": "xemu-project/xemu", "asset": "^xemu-win-x86_64-release\\.zip$",
    "homepage": "https://xemu.app", "requires": "Your own Xbox BIOS, MCPX boot ROM and HDD image" }
]
