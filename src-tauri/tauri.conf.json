{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnionRing",
  "version": "../package.json",
  "identifier": "com.onionring.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OnionRing",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "backgroundColor": "#09080d",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "OnionRing",
    "homepage": "https://github.com/George-Nizor/OnionRing",
    "shortDescription": "One launcher for your emulators and native PC ports",
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGODdEODMzRjA4QkM3RUQKUldUdHg0dndNOWlIVHhLTTVBTm9TZlE2STl4VENSRXhnZENzVGVyeWx0enQyZk9qV3VqQ1lYUDMK",
      "endpoints": [
        "https://github.com/George-Nizor/OnionRing/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
